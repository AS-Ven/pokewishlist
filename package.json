{
  "name": "poke-wishlist",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "backend": "tsx backend/server.ts",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format:check": "prettier --check .",
    "format:front": "prettier --check app.vue composables nuxt.config.ts tsconfig.json eslint.config.js",
    "format:back": "prettier --check backend tsconfig.backend.json",
    "lint": "eslint .",
    "lint:front": "eslint app.vue composables nuxt.config.ts eslint.config.js",
    "lint:back": "eslint backend",
    "test": "vitest",
    "test:front": "vitest --run composables/useWishlist.test.ts",
    "test:back": "vitest --run backend/app.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.backend.json",
    "typecheck:front": "nuxt typecheck",
    "typecheck:back": "tsc -p tsconfig.backend.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@hono/node-server": "^1.19.7",
    "@types/node": "^22.15.0",
    "@nuxt/test-utils": "^3.19.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^17.4.4",
    "hono": "^4.10.4",
    "nuxt": "^3.17.5",
    "@playwright/test": "^1.57.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.1.1",
    "vue-tsc": "^3.3.14",
    "tsx": "^4.20.6"
  }
}
